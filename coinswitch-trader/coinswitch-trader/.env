# CoinSwitch Trading Bot - Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=CoinSwitch Trader
APP_ENV=production
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# CoinSwitch API (set via Settings page or here)
COINSWITCH_API_KEY="9f7e37bc68a33d5addefc7ceb957cd5336aef9b7b3404c00f4a0af1bcc49c58d"
COINSWITCH_API_SECRET="aa18ca959d1a13d7635af410ce76ce09a67952cb1f566b8ed50f5b6c36363fbb"
COINSWITCH_PASSPHRASE=""

# CoinSwitch Endpoints
COINSWITCH_BASE_URL=https://api-trading.coinswitch.co
COINSWITCH_WS_URL=wss://ws.coinswitch.co/

# Encryption key for stored secrets (auto-generated if not set)
ENCRYPTION_KEY=

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# Trading Defaults
DEFAULT_LEVERAGE=1
MAX_DAILY_LOSS_PERCENT=5.0
MAX_POSITION_SIZE_PERCENT=10.0
MAX_OPEN_POSITIONS=5

# Simulation Mode
SIMULATION_MODE=true
