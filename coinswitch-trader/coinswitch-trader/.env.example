# CoinSwitch Trading Bot - Environment Configuration
# Copy to .env and fill in your values

# Application
APP_NAME=CoinSwitch Trader
APP_ENV=production
SECRET_KEY=change-this-to-a-random-string
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ─── CoinSwitch API Credentials ───────────────────────────────────────────────
# Get these from the CoinSwitch HFT / Pro trading portal
#
# API Key  : alphanumeric string shown in the portal
COINSWITCH_API_KEY=

# Secret Key : hex-encoded Ed25519 private key (64 hex chars = 32 bytes)
#              This is NOT a password — it's a cryptographic private key.
#              Example format: a1b2c3d4...e5f6 (128 hex characters)
COINSWITCH_API_SECRET=

# Base URL (do not change)
COINSWITCH_BASE_URL=https://coinswitch.co

# Fernet encryption key for secrets stored in the database (auto-generated if blank)
ENCRYPTION_KEY=

# ─── Alerts (optional) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ─── Risk defaults ────────────────────────────────────────────────────────────
DEFAULT_LEVERAGE=1
MAX_DAILY_LOSS_PERCENT=5.0
MAX_POSITION_SIZE_PERCENT=10.0
MAX_OPEN_POSITIONS=5

# ─── Safety ───────────────────────────────────────────────────────────────────
# Always start true. Set false only after verifying credentials work.
SIMULATION_MODE=true
